# Copy to .env and fill in. .env is git-ignored -- never commit real keys.

# ---- LLM provider (any OpenAI-compatible endpoint) ----
# e.g. OpenAI, DeepSeek, Qwen/DashScope-compatible, SiliconFlow, local vLLM/Ollama
EE6405_LLM_BASE_URL=https://api.deepseek.com
EE6405_LLM_MODEL=deepseek-flash
# deepseek-flash = DeepSeek-V4.1-Flash (legacy name deepseek-v4-flash still works).
# Also available: deepseek-v4-pro.  Docs: https://api-docs.deepseek.com
# Thinking mode: disabled (fast, temperature applies) | enabled (slower, reasoning)
EE6405_LLM_THINKING=disabled
EE6405_LLM_API_KEY=

# ---- Public providers for the eval (see `providers:` in configs/eval.yaml) ----
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---- Embeddings ----
# backend: "local" (sentence-transformers, offline) | "api" (OpenAI-compatible /embeddings)
EE6405_EMBED_BACKEND=local
# the bundled index was built with BAAI/bge-m3
EE6405_EMBED_MODEL=BAAI/bge-m3
EE6405_EMBED_API_KEY=
EE6405_EMBED_BASE_URL=

# ---- Retrieval ----
EE6405_TOP_K=5
EE6405_CHUNK_SIZE=800
EE6405_CHUNK_OVERLAP=120
# dense | bm25 | hybrid
# dense / hybrid need `pip install -r requirements-ml.txt`
EE6405_RETRIEVER=bm25

# ---- Paths (relative to repo root unless absolute) ----
EE6405_DATA_DIR=data
EE6405_INDEX_PATH=data/processed/index.sqlite
EE6405_MEMORY_PATH=data/processed/memory.sqlite
